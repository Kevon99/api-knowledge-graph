# Entorno de desarrollo — copia a .env y personaliza
# postgres / neo4j / redis (infraestructura base v0.1)
PG_USER=akg
PG_PASSWORD=akg_dev_password
PG_DB=akg
# 55432 evita conflicto con un postgres local en 5432 (debe coincidir con akg/config.py)
PG_PORT=55432
NEO4J_PASSWORD=neo4j_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
REDIS_PORT=6379

# Aplicación
AKG_ENV=dev
AKG_SECRET=change-me-in-prod